<Window x:Class="StaleBread.App.Views.CompanionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:StaleBread.App.Views"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StaleBread" Width="380" Height="300" MinWidth="340" MinHeight="280"
 WindowStartupLocation="CenterScreen" ResizeMode="CanResize" AutomationProperties.Name="StaleBread toast companion">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <local:ToastArt x:Name="Mascot" MaxHeight="110"/>
  <TextBlock x:Name="Status" Grid.Row="1" FontSize="17" FontWeight="SemiBold" Text="Watching for breadcrumbs…" HorizontalAlignment="Center" Margin="0,5" TextWrapping="Wrap"/>
  <TextBlock x:Name="Counts" Grid.Row="2" Text="Collecting process history…" HorizontalAlignment="Center" TextWrapping="Wrap"/>
  <TextBlock x:Name="Detail" Grid.Row="3" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,5"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
   <Button Content="_Findings" Click="FindingsClick"/><Button x:Name="PauseButton" Content="_Pause" Click="PauseClick"/>
   <Button Content="_Settings" Click="SettingsClick"/>
  </StackPanel>
 </Grid>
</Window>
